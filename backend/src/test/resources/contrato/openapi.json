{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "SIATE API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/siante2/api/categorias" : {
      "get" : {
        "operationId" : "listarCategorias",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CategoriasResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "categorias-controller" ]
      }
    },
    "/siante2/api/direcciones" : {
      "get" : {
        "operationId" : "buscarDirecciones",
        "parameters" : [ {
          "in" : "query",
          "name" : "texto",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DireccionesResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "direcciones-controller" ]
      }
    },
    "/siante2/api/direcciones/sugerencias" : {
      "get" : {
        "operationId" : "sugerirDirecciones",
        "parameters" : [ {
          "in" : "query",
          "name" : "texto",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "latitud",
          "required" : false,
          "schema" : {
            "type" : "number",
            "format" : "double"
          }
        }, {
          "in" : "query",
          "name" : "longitud",
          "required" : false,
          "schema" : {
            "type" : "number",
            "format" : "double"
          }
        }, {
          "in" : "query",
          "name" : "zoom",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DireccionesResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "direcciones-controller" ]
      }
    },
    "/siante2/api/multimedia" : {
      "get" : {
        "operationId" : "listarMultimedia",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MultimediaResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "multimedia-controller" ]
      }
    },
    "/siante2/api/multimedia/{id}/archivo" : {
      "get" : {
        "operationId" : "obtenerArchivoMultimedia",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/octet-stream" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              },
              "application/pdf" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              },
              "image/gif" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              },
              "image/png" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "multimedia-controller" ]
      }
    },
    "/siante2/api/usuarios/actual" : {
      "get" : {
        "operationId" : "obtenerUsuarioActual",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Usuario"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "usuarios-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "Categoria" : {
        "type" : "object",
        "properties" : {
          "descripcion" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int32"
          },
          "nombre" : {
            "type" : "string"
          }
        },
        "required" : [ "descripcion", "id", "nombre" ]
      },
      "CategoriasResponse" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Categoria"
            }
          }
        },
        "required" : [ "data" ]
      },
      "Direccion" : {
        "type" : "object",
        "properties" : {
          "latitud" : {
            "type" : "number",
            "format" : "double"
          },
          "longitud" : {
            "type" : "number",
            "format" : "double"
          },
          "nombre" : {
            "type" : "string"
          }
        },
        "required" : [ "latitud", "longitud", "nombre" ]
      },
      "DireccionesResponse" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Direccion"
            }
          }
        },
        "required" : [ "data" ]
      },
      "Multimedia" : {
        "type" : "object",
        "properties" : {
          "descripcion" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "descripcion", "id" ]
      },
      "MultimediaResponse" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Multimedia"
            }
          }
        },
        "required" : [ "data" ]
      },
      "Usuario" : {
        "type" : "object",
        "properties" : {
          "apellido" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "grupos" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "id" : {
            "type" : "integer",
            "format" : "int32"
          },
          "ivUser" : {
            "type" : "string"
          },
          "nombre" : {
            "type" : "string"
          }
        },
        "required" : [ "apellido", "email", "grupos", "id", "ivUser", "nombre" ]
      }
    }
  }
}
