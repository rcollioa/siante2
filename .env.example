# Copiar como .env (ignorado por git) y completar. Lo usa docker-compose.yml. En k8s, las credenciales
# van en el secreto (k8s/*/secret.example.yml) y el resto en configMapGenerator de k8s/*/kustomization.yml.
APP_DATASOURCE_URL=jdbc:oracle:thin:@//HOST:1521/SERVICIO
APP_DATASOURCE_USERNAME=USUARIO
APP_DATASOURCE_PASSWORD=CLAVE
APP_CORS_ALLOWED_ORIGINS=
TZ=America/Santiago
JAVA_OPTS=
